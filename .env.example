# Compose reads a root .env automatically. Copy this file to .env and fill it in.
# Keep .env private; never commit it or pass these values as image build arguments.

# Public hostname only: no https:// prefix, port, or trailing slash.
DOMAIN=way.example.org
APP_VERSION=
GHCR_OWNER=

# Generate three DIFFERENT values with: openssl rand -hex 32
MONGO_ROOT_PASSWORD=
MONGO_APP_PASSWORD=
JWT_SECRET=

SMTP_HOST=smtp.example.org
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SENDER_EMAIL=
VIDEO_REQUEST_EMAIL=

# Optional backup service, run manually or schedule on the host.
BACKUP_RETENTION_DAYS=7

# Single-quote values containing $ or # so Compose preserves them literally:
# SMTP_PASS='your-provider-password'
