{
  "private": true,
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev --prefix frontend\" \"npm run server --prefix backend\"",
    "start": "docker compose up -d --wait",
    "deploy:build": "docker compose -f compose.build.yaml build api web",
    "deploy:config": "docker compose config --quiet",
    "frontend": "npm run dev --prefix frontend",
    "backend": "npm run server --prefix backend",
    "test": "node --test backend/tests/*.test.js frontend/tests/*.test.js"
  },
  "devDependencies": {
    "concurrently": "^9.2.5"
  }
}
