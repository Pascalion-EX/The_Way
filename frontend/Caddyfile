{$SITE_ADDRESS} {
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        X-Frame-Options SAMEORIGIN
        -Server
    }

    handle /health/frontend {
        respond "ok" 200
    }

    # Keep API paths intact and out of the React index.html fallback.
    @backend path /api /api/* /health/live /health/ready
    handle @backend {
        request_body {
            max_size 100KB
        }
        reverse_proxy {$API_UPSTREAMS} {
            lb_policy least_conn
            health_uri /health/ready
            health_interval 15s
            health_timeout 3s
            fail_duration 10s
            transport http {
                dial_timeout 3s
                response_header_timeout 45s
            }
        }
    }

    # Hashed Vite assets are immutable. Missing assets return 404, not HTML.
    handle /assets/* {
        root * /srv
        header Cache-Control "public, max-age=31536000, immutable"
        file_server
    }

    # Let direct links/reloads such as /lessons/ID reach React Router.
    handle {
        root * /srv
        header Cache-Control "no-cache"
        try_files {path} /index.html
        file_server
    }
}

# Internal HTTP health listener stays usable when the public site uses HTTPS.
http://127.0.0.1:2016 {
    bind 127.0.0.1
    respond /health/frontend "ok" 200
}
