{
	auto_https off
	admin off
}

:80 {
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
		-Server
	}

	handle /health/frontend {
		respond "ok" 200
	}

	@uploadedImage path_regexp uploadedImage ^/uploads/[a-f0-9]{64}\.webp$
	handle @uploadedImage {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	@uploads path /uploads /uploads/*
	handle @uploads {
		respond 404
	}

	# Traefik routes these directly to the APIs. Keep them out of SPA fallback
	# when this container is accessed on its own.
	@backend path /api /api/* /health/live /health/ready
	handle @backend {
		respond "API requests must go through Traefik" 404
	}

	# Hashed Vite assets are immutable. Missing assets return 404, not HTML.
	handle /assets/* {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Let direct links/reloads such as /lessons/ID reach React Router.
	handle {
		root * /srv
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}

# Loopback-only health listener for the container healthcheck.
http://127.0.0.1:2016 {
	bind 127.0.0.1
	respond /health/frontend "ok" 200
}
