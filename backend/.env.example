# Runtime configuration only. Never put credentials in the Dockerfile.
NODE_ENV=production
PORT=4000

# Must be reachable from inside the container. localhost means the container itself.
MONGODB_URL=

# Generate a random secret with: openssl rand -hex 32
JWT_SECRET=

# Public HTTPS frontend origin, without a trailing slash.
APP_ORIGIN=https://way.example.org

SMTP_HOST=smtp.example.org
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SENDER_EMAIL=
VIDEO_REQUEST_EMAIL=

# A standalone API also processes account emails. Disable when running a separate worker.
EMAIL_WORKER_ENABLED=true

# Enable only behind exactly one trusted proxy, with the API port kept private.
TRUST_PROXY=0
MONGO_POOL_SIZE=20
